# Codebuff / Freebuff 上游 Bearer token。
# 必填。来源是 HAR 或客户端请求里的 Authorization: Bearer <token>。
# 只填写 token 本体，不要带 "Bearer " 前缀。
# 多账号用英文逗号分隔；并发请求会自动分配到空闲账号。
# 示例：FREEBUFF_TOKEN=token-a,token-b,token-c
FREEBUFF_TOKEN=

# 本地 OpenAI-compatible API 的访问密钥。
# 可选。留空表示本地接口不校验 Authorization。
# 如果填写，例如 FREEBUFF_API_KEY=sk-local，调用本项目时需要带：
# Authorization: Bearer sk-local
FREEBUFF_API_KEY=

# Freebuff 上游 API 根地址
FREEBUFF_API_BASE_URL=https://www.codebuff.com

# 广告 provider 尝试顺序。
# 项目会按顺序请求 /api/v1/ads，拿到广告 impression 后再换取 freebuff session。
# HAR 中 gravity 可能返回空广告，zeroclick 返回可用 impression。
FREEBUFF_AD_PROVIDERS=gravity,zeroclick

# 上游 HTTP 请求超时时间，单位秒。
# 流式对话的读取超时已单独放开，这里主要影响普通请求。
FREEBUFF_TIMEOUT=60

# 限流重试的抖动毫秒数（R5）。
# 0 表示不添加抖动，仍然遵守上游 retry_after_ms / reset_at 基础等待。
FREEBUFF_RETRY_JITTER=250

# 数据目录（R1）。
# 所有状态文件（api_keys.json、account_stats.json、admin_data.json、.jwt_secret）
# 都写入该目录。默认 ~/.freebuff2api（非 root 用户可写）。
FREEBUFF2API_DATA_DIR=

# httpx 连接池上限（R3）。
FREEBUFF_HTTPX_MAX_CONNECTIONS=100
FREEBUFF_HTTPX_KEEPALIVE=20
FREEBUFF_HTTPX_KEEPALIVE_EXPIRY=30
FREEBUFF_HTTPX_READ_TIMEOUT=300

# 有界并发（R4）：所有账号繁忙时，最多允许多少个请求排队等待。
# 超过后快速失败返回 503（避免无限堆积）。0 = 不限。
FREEBUFF_MAX_WAITERS=64

# 主动账号健康检查（R7）。
# 每隔 FREEBUFF_HEALTH_INTERVAL 秒对每个空闲账号做一次 get_streak 探活；
# 失败即隔离 FREEBUFF_HEALTH_COOLDOWN 秒。0 = 关闭。
FREEBUFF_HEALTH_INTERVAL=60
FREEBUFF_HEALTH_COOLDOWN=300

# SSE 心跳注释（R10）：流式响应空闲超过该秒数时发送 ": ping" 注释，
# 防止客户端/代理在长生成任务中超时。0 = 关闭。
FREEBUFF_SSE_KEEPALIVE=15

# CLI 扮演用户 ID（gate 修复）。
# 上游 free_mode_cli_required gate 要求聊天请求携带 x-freebuff-acting-user-id。
# 来源：~/.config/manicode/credentials.json 的 default.id。
FREEBUFF_ACTING_USER_ID=

# 已安装的 freebuff CLI 二进制路径（gate 修复）。
# 脚本会从该二进制中提取真实的 Buffy 系统提示词并注入聊天请求，
# 以通过上游 CLI 指纹校验。默认 ~/.config/manicode/freebuff。
FREEBUFF_CLI_PATH=/home/USER/.config/manicode/freebuff

# 是否启用上游代理。
# false：所有上游请求直连，且不会读取系统 HTTP_PROXY / HTTPS_PROXY。
# true：所有上游请求都经过 FREEBUFF_PROXY_URL。
FREEBUFF_PROXY_ENABLED=false

# 上游代理地址。
# 支持 http://、https://、socks5://、socks5h://。
# 示例：http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
FREEBUFF_PROXY_URL=

# 调试模式。
# false：只输出关键运行日志。
# true：输出上游请求/响应、SSE 原始行、OpenAI 转换后 chunk、finalize 异常等详细信息。
FREEBUFF_DEBUG=false

# 日志级别。
# 常用值：DEBUG、INFO、WARNING、ERROR。
# 开启 FREEBUFF_DEBUG=true 时默认会使用 DEBUG。
FREEBUFF_LOG_LEVEL=INFO

# 日志中请求体/响应体最大打印字符数。
# 0 表示不截断；调试复杂问题时可设为 0。
FREEBUFF_LOG_BODY_CHARS=2000

# 是否启用彩色日志。
# true：按日志级别输出 ANSI 颜色。
# false：纯文本日志，适合写入文件或不支持 ANSI 的终端。
FREEBUFF_LOG_COLOR=true

# 服务监听地址。
# 默认 0.0.0.0，仅容器环境或需外部访问时保持默认。
# 本地测试建议设为 127.0.0.1。
FREEBUFF_HOST=0.0.0.0

# 服务监听端口。
# 默认 8000。
FREEBUFF_PORT=8000

# 模拟客户端设备信息：时区。
# HAR 中为 Asia/Shanghai。
FREEBUFF_TIMEZONE=Asia/Shanghai

# 模拟客户端设备信息：语言区域。
# HAR 中为 zh-CN。
FREEBUFF_LOCALE=zh-CN

# 模拟客户端设备信息：操作系统。
# HAR 中为 windows。
FREEBUFF_OS=windows
