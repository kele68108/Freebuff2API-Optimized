[Unit]
Description=Freebuff2API Admin Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freebuff
Group=freebuff
WorkingDirectory=/var/lib/freebuff2api/repo/admin/backend
EnvironmentFile=/var/lib/freebuff2api/repo/.env
Environment=FREEBUFF2API_ADMIN_HOST=127.0.0.1
ExecStart=/var/lib/freebuff2api/repo/admin/venv/bin/uvicorn main:app --host 127.0.0.1 --port 20003
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/freebuff2api/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
